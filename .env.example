# Environment Configuration for PharmaGuard
# Copy this file to .env and fill in your actual values

# Google Gemini API Key (Required for AI-powered clinical recommendations)
# Get your API key from: https://makersuite.google.com/app/apikey
GOOGLE_API_KEY=your_google_api_key_here

# BigQuery Logging (Optional - stores analysis request/response metadata)
ENABLE_BIGQUERY_LOGGING=false
BIGQUERY_PROJECT_ID=
BIGQUERY_DATASET=helixrx_analytics
BIGQUERY_TABLE=analysis_metadata
BIGQUERY_AUTO_CREATE=false

# VCF Upload Archival (Optional - stores each uploaded VCF in Firebase/Cloud Storage)
ENABLE_VCF_ARCHIVE=false
FIREBASE_STORAGE_BUCKET=helixrx-bff6c.firebasestorage.app

# Flask Configuration
FLASK_APP=app.py
FLASK_ENV=development
FLASK_DEBUG=1

# Server Configuration
HOST=0.0.0.0
PORT=5000

# File Upload Configuration (Optional - defaults set in app.py)
MAX_FILE_SIZE_MB=5

# Security (Optional - for production)
SECRET_KEY=your_secret_key_here_change_in_production
PATIENT_SALT=random_string_for_hashing_patient_ids

# CPIC Data Path (Optional - defaults to data/cpic_gene-drug_pairs.xlsx)
CPIC_DATA_PATH=data/cpic_gene-drug_pairs.xlsx
